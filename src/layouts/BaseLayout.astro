---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
const { title = 'UniTrento Master in AI', description = 'Study notebook for the UniTrento Master in Artificial Intelligence' } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
const navItems = [
  { href: `${base}`, label: 'Master overview', detail: 'Artificial Intelligence Systems' },
  { href: `${base}machine-learning/`, label: 'Machine Learning', detail: 'Course overview' },
  { href: `${base}machine-learning/module-1/`, label: 'Machine Learning · Module 1', detail: 'Current module' },
  { href: `${base}machine-learning/module-1/ap/class-1/`, label: 'Class 1 — Bayesian Networks', detail: 'A.P. · Machine Learning' },
  { href: `${base}machine-learning/module-1/ap/class-2/`, label: 'Class 2 — Learning in Graphical Models', detail: 'A.P. · Machine Learning' },
  { href: `${base}machine-learning/module-1/fm/`, label: 'F.M.', detail: 'Machine Learning · Module 1' },
  { href: `${base}machine-learning/module-2/`, label: 'Machine Learning · Module 2', detail: 'Later this semester' },
  { href: '#', label: 'Passerini slides & handouts', detail: 'External resource' },
  { href: 'https://didatticaonline.unitn.it/dol/course/view.php?id=44129', label: 'Farid Moodle', detail: 'Recordings & slides' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f5ef" />
  <title>{title}</title>
</head>
<body>
  <header class="topbar no-print">
    <div class="topbar-inner">
      <a class="brand" href={base}>UniTrento · Master in AI</a>
      <div class="top-actions">
        <button class="action-btn" id="search-trigger">Search</button>
        <button class="action-btn" onclick="window.print()">Export PDF</button>
      </div>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar no-print">
      <div class="nav-group">
        <h3>Master</h3>
        <a class={`nav-link ${current === base ? 'active' : ''}`} href={base}>Overview</a>
      </div>
      <div class="nav-group">
        <h3>Machine Learning</h3>
        <a class="nav-link" href={`${base}machine-learning/`}>Course overview</a>
        <a class="nav-link" href={`${base}machine-learning/module-1/`}>Module 1</a>
        <div class="nav-sub">
          <a class="nav-link" href={`${base}machine-learning/module-1/ap/class-1/`}>Passerini · Class 1</a>
          <a class="nav-link" href={`${base}machine-learning/module-1/ap/class-2/`}>Passerini · Class 2</a>
          <a class="nav-link" href={`${base}machine-learning/module-1/fm/`}>F.M.</a>
        </div>
        <a class="nav-link" href={`${base}machine-learning/module-2/`}>Module 2 <span class="module-badge">Later</span></a>
      </div>
    </aside>

    <main class="content-card"><slot /></main>

    <aside class="toc no-print">
      <h3>On this page</h3>
      <nav id="toc-list"></nav>
    </aside>
  </div>

  <div class="quick-search no-print" id="quick-search" aria-hidden="true">
    <div class="search-panel">
      <input id="search-input" placeholder="Search courses, classes and resources…" autocomplete="off" />
      <div class="search-results" id="search-results"></div>
    </div>
  </div>

  <script define:vars={{ navItems }}>
    const $ = (s) => document.querySelector(s);
    const overlay = $('#quick-search');
    const input = $('#search-input');
    const results = $('#search-results');
    const trigger = $('#search-trigger');
    const escapeHtml = (value) => value.replace(/[&<>'"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const render = (query = '') => {
      const q = query.trim().toLowerCase();
      const items = navItems.filter(i => `${i.label} ${i.detail}`.toLowerCase().includes(q));
      results.innerHTML = items.map(i => `<a class="search-item" href="${i.href}"><strong>${escapeHtml(i.label)}</strong><small>${escapeHtml(i.detail)}</small></a>`).join('') || '<div class="search-item">No matches</div>';
    };
    const open = () => { overlay.classList.add('open'); overlay.setAttribute('aria-hidden','false'); render(); setTimeout(() => input.focus(), 0); };
    const close = () => { overlay.classList.remove('open'); overlay.setAttribute('aria-hidden','true'); };
    trigger?.addEventListener('click', open);
    input?.addEventListener('input', (e) => render(e.target.value));
    overlay?.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
      if (e.key === 'Escape') close();
    });
    const toc = $('#toc-list');
    if (toc) {
      [...document.querySelectorAll('main h2, main h3')].forEach((h, idx) => {
        if (!h.id) h.id = `section-${idx + 1}`;
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        if (h.tagName === 'H3') a.style.paddingLeft = '.7rem';
        toc.appendChild(a);
      });
    }
  </script>
</body>
</html>
