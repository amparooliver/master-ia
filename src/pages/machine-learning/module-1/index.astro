---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Machine Learning · Module 1">
  <div class="eyebrow">Machine Learning · Module 1</div>
  <h1>Module 1</h1>
  <p class="lede">Lectures are separated by professor so the sequence, recordings, slides, and notes remain easy to scan.</p>

  <h2>Professors</h2>
  <div class="teacher-grid">
    <section class="teacher-card">
      <div class="card-kicker">Professor</div>
      <h3>Andrea Passerini</h3>
      <p>Bayesian networks, graphical models, parameter learning, and related topics.</p>
      <div class="card-actions">
        <a class="resource-link" href={`${base}machine-learning/module-1/andrea-passerini/class-1/`}>Class 1</a>
        <a class="resource-link" href={`${base}machine-learning/module-1/andrea-passerini/class-2/`}>Class 2</a>
        <a class="resource-link" target="_blank" rel="noreferrer" href="https://disi.unitn.it/~passerini/teaching/2026-2027/MachineLearning_AIS/index.html">Slides & handouts</a>
      </div>
      <p><small>Recordings: class Moodle.</small></p>
    </section>

    <section class="teacher-card">
      <div class="card-kicker">Professor</div>
      <h3>Farid Melgani</h3>
      <p>Earlier Module 1 lectures, kept in their own sequence.</p>
      <div class="card-actions">
        <a class="resource-link" href={`${base}machine-learning/module-1/farid-melgani/`}>Open notes</a>
        <a class="resource-link" target="_blank" rel="noreferrer" href="https://didatticaonline.unitn.it/dol/course/view.php?id=44129">Moodle recordings & slides</a>
      </div>
    </section>
  </div>
</BaseLayout>
