---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="F.M. · Machine Learning">
  <div class="eyebrow">Machine Learning · Module 1</div>
  <h1>F.M.</h1>
  <p class="lede">Instructor section for the earlier Module 1 lectures.</p>

  <h2>Official course resources</h2>
  <section class="resource-card">
    <h3>UniTrento Moodle</h3>
    <p>Recordings and slides for F.M.'s classes.</p>
    <div class="card-actions">
      <a class="resource-link" target="_blank" rel="noreferrer" href="https://didatticaonline.unitn.it/dol/course/view.php?id=44129">Open Moodle</a>
    </div>
  </section>

  <h2>Classes</h2>
  <div class="class-grid">
    <a class="class-card" href={`${base}machine-learning/module-1/fm/class-1/`}>
      <div class="card-kicker">Class 1</div>
      <h3>Basic Concepts and Signal Acquisition</h3>
      <p>Signals, digitization, image representations, and core machine-learning paradigms.</p>
    </a>
    <a class="class-card" href={`${base}machine-learning/module-1/fm/class-2/`}>
      <div class="card-kicker">Class 2</div>
      <h3>ML Systems and Fish Classification</h3>
      <p>ML pipelines, supervised-system design, decision boundaries, and overfitting.</p>
    </a>
    <a class="class-card" href={`${base}machine-learning/module-1/fm/class-3/`}>
      <div class="card-kicker">Class 3</div>
      <h3>Statistical Estimation Theory</h3>
      <p>Parzen windows, Gaussian mixtures, and expectation–maximization.</p>
    </a>
    <a class="class-card" href={`${base}machine-learning/module-1/fm/class-4/`}>
      <div class="card-kicker">Class 4</div>
      <h3>Feature Reduction</h3>
      <p>Hughes effect, selection versus transformation, and subset scoring.</p>
    </a>
  </div>
</BaseLayout>
