---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="UniTrento Master in AI · Study Notebook">
  <h1>Master in Artificial Intelligence</h1>
  <p class="lede">A structured digital notebook for the full master’s degree</p>

  <h2>Courses</h2>
  <div class="course-grid">
    <a class="course-card" href={`${base}machine-learning/`}>
      <div class="card-kicker">Current course</div>
      <h3>Machine Learning</h3>
      <p>Module 1 notes organized by instructor, with Module 2 already reserved.</p>
      <div class="course-meta">F.M. · A.P.</div>
    </a>
  </div>

  <h2>Notebook convention</h2>
  <p>Lecture and slide content appears normally. Study additions are explicitly labeled as <strong>Further explanation</strong>, <strong>Simplified definition</strong>, <strong>Example</strong>, <strong>Blackboard example</strong>, or <strong>Useful connection</strong>.</p>
</BaseLayout>
