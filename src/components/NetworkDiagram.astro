---
const { variant = 'chain' } = Astro.props;
---
<div class="network" aria-label="Bayesian network diagram">
  {variant === 'medical' && (
    <svg viewBox="0 0 680 240" role="img">
      <defs><marker id="a1" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a1)">
        <path d="M125 55 L245 160"/><path d="M125 55 L370 160"/><path d="M555 55 L245 160"/><path d="M555 55 L370 160"/><path d="M555 55 L555 160"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="65" y="25" width="120" height="48" rx="12"/><rect x="495" y="25" width="120" height="48" rx="12"/>
        <rect x="190" y="160" width="110" height="48" rx="12"/><rect x="315" y="160" width="110" height="48" rx="12"/><rect x="500" y="160" width="110" height="48" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="16" text-anchor="middle" fill="currentColor">
        <text x="125" y="55">Influenza</text><text x="555" y="55">Pneumonia</text><text x="245" y="190">Fever</text><text x="370" y="190">Cough</text><text x="555" y="190">Lab test</text>
      </g>
    </svg>
  )}
  {variant === 'collider' && (
    <svg viewBox="0 0 680 230" role="img">
      <defs><marker id="a2" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a2)">
        <path d="M145 60 L310 125"/><path d="M535 60 L370 125"/><path d="M340 150 L340 198"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="75" y="30" width="140" height="48" rx="12"/><rect x="465" y="30" width="140" height="48" rx="12"/><rect x="275" y="110" width="130" height="48" rx="12"/><rect x="270" y="190" width="140" height="34" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="15" text-anchor="middle" fill="currentColor">
        <text x="145" y="60">Burglary</text><text x="535" y="60">Earthquake</text><text x="340" y="140">Alarm</text><text x="340" y="213">Phone call</text>
      </g>
    </svg>
  )}
  {variant === 'naive-bayes' && (
    <svg viewBox="0 0 720 250" role="img" aria-label="Naive Bayes network">
      <defs><marker id="a4" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a4)">
        <path d="M360 85 L125 165"/><path d="M360 85 L285 165"/><path d="M360 85 L435 165"/><path d="M360 85 L595 165"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="300" y="30" width="120" height="50" rx="12"/>
        <rect x="70" y="165" width="110" height="48" rx="12"/><rect x="230" y="165" width="110" height="48" rx="12"/>
        <rect x="380" y="165" width="110" height="48" rx="12"/><rect x="540" y="165" width="110" height="48" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="16" text-anchor="middle" fill="currentColor">
        <text x="360" y="61">Class Y</text><text x="125" y="195">X₁</text><text x="285" y="195">X₂</text><text x="435" y="195">X₃</text><text x="595" y="195">X₄</text>
      </g>
    </svg>
  )}
  {variant === 'asia' && (
    <svg viewBox="0 0 820 430" role="img" aria-label="Asia Bayesian network">
      <defs><marker id="a5" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a5)">
        <path d="M140 68 L220 145"/><path d="M650 68 L545 145"/><path d="M650 68 L690 235"/>
        <path d="M260 170 L385 240"/><path d="M520 170 L435 240"/><path d="M410 275 L300 345"/>
        <path d="M410 275 L520 345"/><path d="M690 260 L545 345"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="70" y="35" width="140" height="48" rx="12"/><rect x="585" y="35" width="130" height="48" rx="12"/>
        <rect x="180" y="145" width="160" height="48" rx="12"/><rect x="465" y="145" width="160" height="48" rx="12"/>
        <rect x="620" y="235" width="140" height="48" rx="12"/><rect x="330" y="235" width="160" height="48" rx="12"/>
        <rect x="235" y="345" width="130" height="48" rx="12"/><rect x="475" y="345" width="140" height="48" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="14" text-anchor="middle" fill="currentColor">
        <text x="140" y="65">Visit to Asia</text><text x="650" y="65">Smoker</text>
        <text x="260" y="175">Tuberculosis</text><text x="545" y="175">Lung cancer</text>
        <text x="690" y="265">Bronchitis</text><text x="410" y="265">TB or cancer</text>
        <text x="300" y="375">Positive X-ray</text><text x="545" y="375">Dyspnoea</text>
      </g>
    </svg>
  )}
  {variant === 'romania-route' && (
    <svg viewBox="0 0 760 260" role="img" aria-label="Romania route example">
      <defs><marker id="a6" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a6)">
        <path d="M150 130 L300 70"/><path d="M360 70 L500 130"/><path d="M560 130 L660 130"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="80" y="105" width="140" height="50" rx="12"/>
        <rect x="270" y="45" width="120" height="50" rx="12"/>
        <rect x="470" y="105" width="120" height="50" rx="12"/>
        <rect x="630" y="105" width="100" height="50" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="16" text-anchor="middle" fill="currentColor">
        <text x="150" y="136">Arad</text><text x="330" y="76">Sibiu</text><text x="530" y="136">Fagaras</text><text x="680" y="136">Bucharest</text>
      </g>
    </svg>
  )}
  {variant === 'lrta-grid' && (
    <svg viewBox="0 0 720 420" role="img" aria-label="LRTA star Example 2 graph">
      <g fill="none" stroke="currentColor" stroke-width="2">
        <path d="M140 90 L360 90 L580 90"/>
        <path d="M140 210 L360 210 L580 210"/>
        <path d="M140 330 L360 330 L580 330"/>
        <path d="M580 90 L580 210 L580 330"/>
      </g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2">
        <rect x="90" y="60" width="100" height="60" rx="12"/><rect x="310" y="60" width="100" height="60" rx="12"/><rect x="530" y="60" width="100" height="60" rx="12"/>
        <rect x="90" y="180" width="100" height="60" rx="12"/><rect x="310" y="180" width="100" height="60" rx="12"/><rect x="530" y="180" width="100" height="60" rx="12"/>
        <rect x="90" y="300" width="100" height="60" rx="12"/><rect x="310" y="300" width="100" height="60" rx="12"/><rect x="530" y="300" width="100" height="60" rx="12"/>
      </g>
      <g font-family="Poppins, sans-serif" font-size="15" text-anchor="middle" fill="currentColor">
        <text x="140" y="87">N1 · h=2</text><text x="360" y="87">N2 · h=3</text><text x="580" y="82">N3 · h=4</text><text x="580" y="102">Start</text>
        <text x="140" y="207">N4 · h=1</text><text x="360" y="207">N5 · h=2</text><text x="580" y="207">N6 · h=3</text>
        <text x="140" y="327">N7 · h=0</text><text x="140" y="347">Goal</text><text x="360" y="327">N8 · h=1</text><text x="580" y="327">N9 · h=2</text>
      </g>
    </svg>
  )}
  {variant === 'chain' && (
    <svg viewBox="0 0 680 130" role="img">
      <defs><marker id="a3" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="currentColor" /></marker></defs>
      <g fill="none" stroke="currentColor" stroke-width="2" marker-end="url(#a3)"><path d="M190 65 L290 65"/><path d="M390 65 L490 65"/></g>
      <g fill="#fffdf8" stroke="currentColor" stroke-width="2"><rect x="70" y="40" width="120" height="48" rx="12"/><rect x="290" y="40" width="100" height="48" rx="12"/><rect x="490" y="40" width="120" height="48" rx="12"/></g>
      <g font-family="Poppins, sans-serif" font-size="16" text-anchor="middle" fill="currentColor"><text x="130" y="70">Cloudy</text><text x="340" y="70">Rainy</text><text x="550" y="70">Wet</text></g>
    </svg>
  )}
</div>
